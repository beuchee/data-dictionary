# Local, uncommitted helper scripts (not part of the build pipeline).
export_review_sheet.py

# Generated by build.py — regenerated by CI on every push, for both GitHub Pages
# (.github/workflows/build-and-deploy.yml) and GitLab Pages (.gitlab-ci.yml).
# Never commit them: a fork that publishes without running build.py serves a site
# whose data files 404, and the app dies on `DATA is not defined`.
legacy/data.json
legacy/data_inline.js
legacy/resolved_concept_ids.json
legacy/concept_sets_resolved/

