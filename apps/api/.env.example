# Data Dictionary API configuration. All variables are prefixed DD_.
#
# A template: in development, copy it to .env (loaded on startup). In
# production, inject these as environment variables (systemd EnvironmentFile=
# with chmod 600, Docker env_file / secrets) rather than shipping a .env.

# --- Data directory ---------------------------------------------------------
# Instance state: the SQLite database and the encryption key file (secret.key).
DD_DATA_DIR=~/.data-dictionary

# --- Content repository -----------------------------------------------------
# Working copy of the dictionary content (concept_sets/, projects/, config.json…).
# Leave UNSET in development to read the repo the API runs from; defaults to
# {DD_DATA_DIR}/content otherwise (Docker: /var/lib/data-dictionary/content).
# DD_CONTENT_DIR=/path/to/data-dictionary
# Remote of the content repository. Set, the API clones it (full history) into
# DD_CONTENT_DIR on first start, pulls from it, and pushes commits and proposal
# branches to it. Unset: the working copy's own `origin`. https or ssh only.
# DD_CONTENT_REPO_URL=https://github.com/indicate-eu/data-dictionary
# Unset: config.json `repository.branch`, else main.
# DD_CONTENT_BRANCH=main
# Service token (GitHub PAT / GitLab project or personal token) for a private
# remote, direct commits, and proposals of users who did not sign in with the
# forge. Never logged nor returned.
# DD_GIT_TOKEN=
# Committer of the commits the server makes (the author is the user).
# DD_GIT_AUTHOR_NAME=Data Dictionary
# DD_GIT_AUTHOR_EMAIL=data-dictionary@example.org

# --- Public URL and OAuth sign-in -------------------------------------------
# Public base URL of the web app, which serves the API under /api/v1. OAuth
# redirect URIs are built from it only; register with each provider:
#   {DD_PUBLIC_URL}/api/v1/auth/oauth/{github|gitlab|orcid}/callback
DD_PUBLIC_URL=http://localhost:3000
# A provider is enabled when both its client id and secret are set.
# GitHub OAuth app. Scope: `repo` instead of `public_repo` for a private repo.
# DD_OAUTH_GITHUB_CLIENT_ID=
# DD_OAUTH_GITHUB_CLIENT_SECRET=
# DD_OAUTH_GITHUB_SCOPE=read:user user:email public_repo
# GitLab application (gitlab.com or self-hosted), scopes read_user + api.
# DD_OAUTH_GITLAB_CLIENT_ID=
# DD_OAUTH_GITLAB_CLIENT_SECRET=
# DD_OAUTH_GITLAB_BASE_URL=https://gitlab.com
# ORCID (identity only: fills the profile's ORCID iD).
# DD_OAUTH_ORCID_CLIENT_ID=
# DD_OAUTH_ORCID_CLIENT_SECRET=
# DD_OAUTH_ORCID_SANDBOX=false
# Role of the accounts an OAuth sign-in creates (never admin).
# DD_OAUTH_DEFAULT_ROLE=viewer

# --- OMOP vocabulary --------------------------------------------------------
# Imported ATHENA vocabularies live in {DD_DATA_DIR}/vocabulary/. Server folders
# an admin may import an ATHENA export from, comma-separated (uploads from the
# browser always work):
# DD_VOCABULARY_IMPORT_ROOTS=/srv/athena

# --- Database ---------------------------------------------------------------
# Leave UNSET to use {DD_DATA_DIR}/data-dictionary.db.
# DD_DATABASE_URL=postgresql+asyncpg://dd:dd@localhost:5432/data_dictionary
# Explicit SQLite path (4 slashes = absolute path):
# DD_DATABASE_URL=sqlite+aiosqlite:////var/lib/data-dictionary/data-dictionary.db

# --- Auth -------------------------------------------------------------------
# CHANGE this in any real deployment: the server refuses to boot with the
# default unless DD_DEBUG=true. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
DD_SECRET_KEY=insecure-dev-secret-change-in-production
DD_ALGORITHM=HS256
DD_ACCESS_TOKEN_EXPIRE_MINUTES=1440
DD_REFRESH_TOKEN_EXPIRE_DAYS=30
DD_PASSWORD_MIN_LENGTH=12

# --- Encryption of secrets at rest ------------------------------------------
# urlsafe base64 of 32 bytes. Unset: generated into {DD_DATA_DIR}/secret.key.
# DD_ENCRYPTION_KEY=
# Rotated-out keys, comma-separated, kept readable:
# DD_ENCRYPTION_OLD_KEYS=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
DD_CORS_ORIGINS=http://localhost:3000

DD_DEBUG=false
