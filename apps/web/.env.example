# Web app configuration. Copy to .env.local to override.

# Server mode: the API base URL. "/" goes through the vite dev proxy (/api → API_PORT).
# Unset or empty: static mode (no login, content from data/data.json built by build.py).
# `npm run dev:all` sets "/" when this is unset; `npm run dev:client` forces static mode.
# VITE_API_URL=/

# Dev ports (defaults 3000 / 8000).
# WEB_PORT=3000
# API_PORT=8000
