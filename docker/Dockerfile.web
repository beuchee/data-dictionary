# syntax=docker/dockerfile:1.7
# Build context is the repo root (see docker-compose.yml).
FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/ apps/web/
COPY packages/ packages/
# The vite plugin serves the instance config and its branding files.
# TODO(v2-cutover): branding files move out of legacy/.
COPY config.json ./config.json
COPY legacy/logo.png legacy/favicon.png legacy/
RUN npm ci --workspace web --include-workspace-root=false

WORKDIR /app/apps/web
# Server mode: a truthy VITE_API_URL makes isServerMode() true at build time.
# Sub-path deployment: set BASE_PATH=/my-prefix/ (it becomes the VITE_API_URL default).
ARG BASE_PATH=/
ENV BASE_PATH=$BASE_PATH
ARG VITE_API_URL=$BASE_PATH
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:alpine
COPY --from=build /app/apps/web/dist /usr/share/nginx/html
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
